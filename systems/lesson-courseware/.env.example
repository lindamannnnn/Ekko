# ===== 模型配置（免费弱模型为默认引擎；升级强模型只改这里）=====
# 以下为 OpenAI 兼容接口。v3 链路默认使用免费弱模型（如 GLM-4-Flash）。
# 升级路线：把 AI_MODEL / AI_BASE_URL / AI_API_KEY 换成更强的模型
#            （如 deepseek-chat / gpt-4o），确定性层完全不动，仅 LLM 层品析变好。

# 示例（智谱 GLM-4-Flash）：
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash

# 可选：HTTP/HTTPS 代理（用于访问模型 API）
# AI_PROXY=http://127.0.0.1:7890

# 可选：覆盖默认引擎（默认 v3，一般无需设置）
# COURSEWARE_ENGINE=v3
