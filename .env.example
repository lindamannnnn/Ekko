# ============================================
# 课评系统 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填入你自己的值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# --------- 安全密钥（必填，生产务必修改） ---------
# 用于会话签名、邮箱验证/密码重置 token 签名。生产环境请替换为随机长字符串
SECRET_KEY=change-me-in-production

# --------- AI 模型配置（必填） ---------
# 支持任意 OpenAI 兼容接口，填写你所使用服务商的信息即可

# 服务商 API 密钥
# 支持多 KEY 轮询：把多个 key 用英文逗号分隔填入，例如 key1,key2,key3
# 当其中一个 key 限流/失败时，系统会自动切换到下一个 key
AI_API_KEY=

# 接口地址（示例见下方注释，按需选择其一）
#   Kimi/Moonshot : https://api.moonshot.cn/v1
#   DeepSeek      : https://api.deepseek.com/v1
#   OpenAI        : https://api.openai.com/v1
#   通义千问       : https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.moonshot.cn/v1

# 模型名称，例如 moonshot-v1-8k / deepseek-chat / gpt-4o-mini
AI_MODEL=moonshot-v1-8k


# --------- 代码仓库推送（可选） ---------
# 仅在使用「一键推送到 git 仓库」功能时需要填写
GIT_API_KEY=
GIT_REPO=


# --------- 在线判题系统 OJ（可选，仅编程类机构使用） ---------
# 非编程机构可忽略此段，留空即可
OJ_BASE_URL=
OJ_USERNAME=
OJ_PASSWORD=

# --------- 邮件服务（P2 邮箱验证 / 密码重置；不填则进入 dev 模式） ---------
# 不配置 MAIL_PASSWORD 时：注册/找回密码不会真发信，验证链接会打印到服务端控制台，
# 方便本地无邮箱即可跑通整条流程。需要真实发信时再填下面各项（QQ 邮箱示例）。
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=587
# MAIL_USERNAME=你的QQ号@qq.com
# MAIL_PASSWORD=你的QQ邮箱授权码（非登录密码）
# MAIL_DEFAULT_SENDER=你的QQ号@qq.com
# MAIL_USE_TLS=true

# --------- 平台总后台管理员（必填） ---------
# 超级管理员登录邮箱与密码（用于 /<ADMIN_PATH>/ 后台）
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-in-production

# --------- 后台入口随机化（防后台被扫，必填） ---------
# 后台实际访问路径前缀：入口为 /<ADMIN_PATH>/（例如 /Fkk0jsD_bw/）
# 上线务必改为服务器专属随机串，不要使用默认值
ADMIN_PATH=Fkk0jsD_bw
# 进入后台前的网关密钥（第二道门，密钥错误直接挡在门外），务必改为随机串
ADMIN_GATE_KEY=change-me-in-production

# --------- 数据库（可选，默认 SQLite） ---------
# 留空则使用项目内 SQLite；多用户并发建议改用 Postgres：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ekko

# --------- 大模型访问代理（可选，默认直连） ---------
# 默认留空 = 直连（不继承系统 HTTP(S)_PROXY，避免部署机代理干扰）
# 仅当部署环境必须走代理才能访问大模型时填写，例如 http://127.0.0.1:7897
AI_PROXY=

